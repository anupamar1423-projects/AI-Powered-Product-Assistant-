# Local configuration template. run_project.bat copies this to .env and then
# generates local-only secrets with: python manage.py prepare_local_env
# Never commit the real .env file.

DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# SQLite is the no-password local default.
DATABASE_URL=
DB_ENGINE=sqlite
SQLITE_PATH=db.sqlite3
MEDIA_ROOT=media

# PostgreSQL alternative (used when DB_ENGINE=postgresql or DATABASE_URL is set).
DB_NAME=product_assistant
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# AI provider: ollama, huggingface, or offline.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
HF_API_TOKEN=
HF_TEXT_MODEL=meta-llama/Llama-3.2-3B-Instruct
HF_INFERENCE_PROVIDER=auto
HF_MAX_TOKENS=260
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
AI_TIMEOUT_SECONDS=30

# Local Streamlit <-> Django connection. prepare_local_env fills the secrets.
DJANGO_BASE_URL=http://127.0.0.1:8000
STREAMLIT_API_USER=studio
STREAMLIT_API_TOKEN=
STREAMLIT_CREATOR_PASSWORD=

# Deployment only (use Hugging Face Space Secrets for the password).
DEPLOY_ADMIN_USERNAME=storeadmin
DEPLOY_ADMIN_EMAIL=
DEPLOY_ADMIN_PASSWORD=
